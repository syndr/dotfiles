# Use a container image for SSH (old network devices)
#
# Works with either Docker or Podman.
#
# Make sure that ~/.ssh/config.openssh7 exists and then
# source this file in your .bashrc or .zshrc
#
# The container image is built automatically on first use (it compiles
# OpenSSH 7.0 from source, so the first run takes a while).
#
# Environment overrides:
#   OLDSSH_ENGINE  force 'docker' or 'podman' (default: auto-detect, prefer podman)
#   OLDSSH_IMAGE   image name:tag to use/build (default: openssh7-client:7.0)
#   OLDSSH_DIR     directory holding the Dockerfile (default: this file's dir)
#

# Resolve this file's directory (holds the Dockerfile) at source time, portably
# across bash and zsh, falling back to the known install path.
if [ -n "${BASH_SOURCE:-}" ]; then
  _oldssh_self="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
  _oldssh_self="${(%):-%x}"
else
  _oldssh_self=""
fi
if [ -n "$_oldssh_self" ]; then
  _OLDSSH_DIR_DEFAULT="$(cd "$(dirname "$_oldssh_self")" 2>/dev/null && pwd)"
fi
: "${_OLDSSH_DIR_DEFAULT:=$HOME/scripts/ssh_7}"
unset _oldssh_self

oldssh() {
  # Pick a container engine.
  local engine="${OLDSSH_ENGINE:-}"
  if [[ -z "$engine" ]]; then
    if command -v podman >/dev/null 2>&1; then
      engine=podman
    elif command -v docker >/dev/null 2>&1; then
      engine=docker
    else
      echo "oldssh: no container engine found (need podman or docker)" >&2
      return 1
    fi
  fi

  local image="${OLDSSH_IMAGE:-openssh7-client:7.0}"
  local srcdir="${OLDSSH_DIR:-$_OLDSSH_DIR_DEFAULT}"

  # Build the image on first use. `image inspect` works on both engines and,
  # unlike a registry pull, resolves the locally-built short name without
  # touching any registry.
  if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
    echo "oldssh: image '$image' not found; building with $engine (one-time, compiles OpenSSH 7.0 from source)..." >&2
    if ! "$engine" build \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        -t "$image" "$srcdir"; then
      echo "oldssh: failed to build '$image' from $srcdir" >&2
      return 1
    fi
  fi

  # Rootless podman remaps host UIDs into a user namespace; --userns=keep-id
  # keeps our host UID/GID inside the container so the mounted ~/.ssh keys and
  # the -u override line up the same way they do under docker.
  local engine_args=()
  if [[ "$engine" == "podman" ]]; then
    engine_args+=(--userns=keep-id)
  fi

  local has_user=0
  for arg in "$@"; do
    # Check for user@host pattern
    if [[ "$arg" =~ ^[^@]+@[^@]+$ ]]; then
      has_user=1
      break
    fi
    # Check for -l or -o User=
    if [[ "$arg" == "-l" ]] || [[ "$arg" == "-l"* ]] || [[ "$arg" == "-o" && "$arg" == *"User="* ]]; then
      has_user=1
      break
    fi
  done

  local run_args=(
    run --rm -it
    "${engine_args[@]}"
    -v "$HOME/.ssh:/home/user/.ssh:ro"
    -u "$(id -u):$(id -g)"
    -w /home/user
    "$image" -F /home/user/.ssh/config.openssh7
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
  )

  if [[ $has_user -eq 0 ]]; then
    "$engine" "${run_args[@]}" -l "$USER" "$@"
  else
    "$engine" "${run_args[@]}" "$@"
  fi
}
